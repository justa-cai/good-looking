# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
dist-ssr/
*.local

# 临时文件（调试脚本、截图、日志、中间产物 —— 见 CLAUDE.md 约定）
tmp/

# 浏览器自动化工具的落盘产物（截图、快照、控制台日志）
.playwright-cli/
.playwright-mcp/

# Python（模型导出 / 量化 pipeline）
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# 模型权重：默认不入库，见 CLAUDE.md「模型资产管理」
# 唯一的例外是下面显式放行的那一个 —— 它是**部署产物**，随站点一起发布，
# 所以必须进仓库；其余中间产物（fp32 的、int8 的、别人的）一律不进。
*.onnx
*.onnx.data
*.safetensors
*.pth
*.bin
!public/models/.gitkeep

# 路线 B 的量化模型：54 MB，随 GitHub Pages 同源发布。
# 放行的理由和代价都写在 CLAUDE.md「模型资产管理」里，改之前先读那一节。
!public/models/attractive.int4.onnx

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.swp
*~

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 环境变量
.env
.env.*
!.env.example
